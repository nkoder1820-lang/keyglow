pkgname=keyglow
pkgver=1.2.0
pkgrel=1
pkgdesc='Backlight scenes for the Cosmic Byte CB Artemis keyboard'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 "${KEYGLOW_BUILD_DIR:-build}/keyglow" "$pkgdir/usr/bin/keyglow"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 udev/70-keyglow.rules "$pkgdir/usr/lib/udev/rules.d/70-keyglow.rules"
  install -Dm644 "$startdir/keyglow.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/keyglow.svg"
  install -Dm644 "$startdir/keyglow.desktop" "$pkgdir/usr/share/applications/keyglow.desktop"
}
